set shell := ["bash", "-cu"]

module_name := `python - <<'PY'
import tomllib
from pathlib import Path

data = tomllib.loads(Path("pyproject.toml').read_text())
name = data["project"]["name"]
print(name.replace("-", "_"))
PY`

default:
    @just --list

sync:
    uv sync --dev

run:
    uv run python -m {{module_name}}

test:
    uv run pytest

test-file file:
    uv run pytest {{file}}

lint:
    ruff check .

fmt:
    ruff format .

typecheck:
    pyright

coverage:
    uv run pytest --cov --cov-report=term-missing

check: lint typecheck test

notebook:
    uv run jupyter lab

lock:
    uv lock

tree:
    uv tree

flake-check:
    nix flake check

clean:
    rm -rf .pytest_cache .ruff_cache .pyright htmlcov .coverage .coverage.*
    find . -type d -name __pycache__ -prune -exec rm -rf {} +
