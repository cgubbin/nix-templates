set shell := ["bash", "-cu"]

default:
    @just --list

update:
    pixi update

test:
    pixi run pytest

lint:
    ruff check .

format:
    ruff format .

typecheck:
    pyright

check: lint typecheck test

lock:
    pixi lock

tree:
    pixi tree

flake-check:
    nix flake check

clean:
    rm -rf .pytest_cache .ruff_cache .pyright htmlcov .coverage .coverage.*
    find . -type d -name __pycache__ -prune -exec rm -rf {} +
