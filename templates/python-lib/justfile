set shell := ["bash", "-cu"]

default:
    @just --list

sync:
    uv sync --dev

test:
    uv run pytest

lint:
    uv run ruff check .

format:
    uv run ruff format .

typecheck:
    uv run pyright

check: lint typecheck test

notebook:
    uv run jupyter lab

lock:
    uv lock

tree:
    uv tree

clean:
    rm -rf .pytest_cache .ruff_cache .pyright htmlcov .coverage .coverage.*
    find . -type d -name __pycache__ -prune -exec rm -rf {} +
